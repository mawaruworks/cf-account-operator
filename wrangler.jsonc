{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-account-operator",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "PROFILES",
      "bucket_name": "cf-account-operator-profiles"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-account-operator",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "AccountCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AccountCoordinator"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
