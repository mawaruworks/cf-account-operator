{
  "name": "cf-account-operator",
  "version": "0.2.0",
  "description": "A self-hosted, human-in-the-loop browser automation gateway for Cloudflare Browser Run and MCP.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinariku/cf-account-operator.git"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:local": "tsc -p tsconfig.local.json --noEmit",
    "cdp:mcp": "tsx local/server.ts",
    "chrome-devtools:mcp": "node local/chrome-devtools-mcp.mjs",
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.24.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/node": "^26.6.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=22"
  }
}
